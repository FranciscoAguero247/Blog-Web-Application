<%- include("partials/header.ejs") %>

<a href="/groups/<%= group.slug %>" class="back-btn">
  <i class="fa-solid fa-chevron-left"></i> Back to <%= group.name %>
</a>

<section class="container pb-5">
  <div class="group-hero text-start mb-4">
    <p class="community-slug">/<%= group.slug %></p>
    <h1>Moderation Queue</h1>
    <p>Review reports from community members and close each case as resolved or dismissed.</p>
  </div>

  <div class="group-hero text-start mt-2 mb-4">
    <h2 class="h3">Moderator Overview</h2>
    <p>Monitor the current health of the community and spot cases that need attention.</p>
  </div>

  <div class="d-flex flex-wrap gap-3 mb-4">
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Open reports</p>
      <h3 class="mb-0"><%= moderationOverview.openReports %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Resolved</p>
      <h3 class="mb-0"><%= moderationOverview.resolvedReports %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Dismissed</p>
      <h3 class="mb-0"><%= moderationOverview.dismissedReports %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Recent reports</p>
      <h3 class="mb-0"><%= moderationOverview.recentReports %></h3>
    </div>
  </div>

  <div class="group-hero text-start mt-2 mb-4">
    <h2 class="h3">Community health signals</h2>
  </div>

  <div class="d-flex flex-wrap gap-3 mb-4">
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Repeat reporters</p>
      <h3 class="mb-0"><%= moderationOverview.repeatReporters %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Flagged authors</p>
      <h3 class="mb-0"><%= moderationOverview.flaggedAuthors %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Flagged posts</p>
      <h3 class="mb-0"><%= moderationOverview.flaggedPosts %></h3>
    </div>
    <div class="feed-card text-start" style="min-width: 180px;">
      <p class="mb-1 text-white-50">Flagged comments</p>
      <h3 class="mb-0"><%= moderationOverview.flaggedComments %></h3>
    </div>
  </div>

  <% if (moderationOverview.escalationAlerts && moderationOverview.escalationAlerts.length > 0) { %>
    <div class="feed-card text-start mb-4 border border-warning">
      <p class="mb-2"><strong>Escalation watch</strong></p>
      <ul class="mb-0 ps-3">
        <% moderationOverview.escalationAlerts.forEach(alert => { %>
          <li>
            <strong><%= alert.alert_title %>:</strong>
            <% if (alert.alert_type === 'repeat_reporter') { %>
              @<%= alert.label %> has <%= alert.report_count %> open reports
            <% } else { %>
              @<%= alert.label %> is flagged on <%= alert.report_count %> open reports
            <% } %>
            <% if (moderationOverview.topReasons && moderationOverview.topReasons.length > 0) { %>
              <span class="text-white-50">— repeat report</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (moderationOverview.hotSpots && moderationOverview.hotSpots.length > 0) { %>
    <div class="feed-card text-start mb-4">
      <p class="mb-2"><strong>Hot spots</strong></p>
      <ul class="mb-0 ps-3">
        <% moderationOverview.hotSpots.forEach(item => { %>
          <li>
            <% if (item.target_type === 'post') { %>
              Post: <%= item.target_name %> (<%= item.report_count %> reports)
            <% } else if (item.target_type === 'comment') { %>
              Comment: <%= item.target_name %> (<%= item.report_count %> reports)
            <% } else { %>
              Reporter: @<%= item.target_name %> (<%= item.report_count %> reports)
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (moderationOverview.topReasons && moderationOverview.topReasons.length > 0) { %>
    <div class="feed-card text-start mb-4">
      <p class="mb-2"><strong>Top open report reasons</strong></p>
      <ul class="mb-0 ps-3">
        <% moderationOverview.topReasons.forEach(reason => { %>
          <li><%= reason.reason %> (<%= reason.reason_count %>)</li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="GET" action="/groups/<%= group.slug %>/moderation" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <% if (reportStatusFilter !== 'all') { %>
      <input type="hidden" name="status" value="<%= reportStatusFilter %>">
    <% } %>
    <input
      type="search"
      name="search"
      value="<%= reportSearch || '' %>"
      placeholder="Search reports"
      class="form-control"
      style="max-width: 220px;"
    >
    <input
      type="search"
      name="reporter"
      value="<%= reportReporter || '' %>"
      placeholder="Filter by reporter"
      class="form-control"
      style="max-width: 220px;"
    >
    <label class="d-flex align-items-center gap-2 mb-0">
      <span class="text-white-50">From</span>
      <input type="date" name="dateFrom" value="<%= reportDateFrom || '' %>" class="form-control" style="max-width: 170px;">
    </label>
    <label class="d-flex align-items-center gap-2 mb-0">
      <span class="text-white-50">To</span>
      <input type="date" name="dateTo" value="<%= reportDateTo || '' %>" class="form-control" style="max-width: 170px;">
    </label>
    <button type="submit" class="button-19 owner-button">Search</button>
    <% if (reportSearch || reportReporter || reportDateFrom || reportDateTo) { %>
      <a href="/groups/<%= group.slug %>/moderation<%= reportStatusFilter === 'all' ? '' : '?status=' + reportStatusFilter %>" class="button-19 owner-button">Clear</a>
    <% } %>
  </form>

  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <% const reportFilterParams = [reportSearch ? `search=${encodeURIComponent(reportSearch)}` : '', reportReporter ? `reporter=${encodeURIComponent(reportReporter)}` : '', reportDateFrom ? `dateFrom=${encodeURIComponent(reportDateFrom)}` : '', reportDateTo ? `dateTo=${encodeURIComponent(reportDateTo)}` : ''].filter(Boolean); %>
    <% const reportFilterSuffix = reportFilterParams.length > 0 ? `?${reportFilterParams.join('&')}` : ''; %>
    <a
      href="/groups/<%= group.slug %>/moderation<%= reportFilterSuffix %>"
      class="button-19 owner-button"
    >
      All<%= reportStatusFilter === 'all' ? ' (active)' : '' %>
    </a>
    <a
      href="/groups/<%= group.slug %>/moderation?status=open<%= reportFilterParams.length > 0 ? '&' + reportFilterParams.join('&') : '' %>"
      class="button-19 owner-button"
    >
      Open<%= reportStatusFilter === 'open' ? ' (active)' : '' %>
    </a>
    <a
      href="/groups/<%= group.slug %>/moderation?status=resolved<%= reportFilterParams.length > 0 ? '&' + reportFilterParams.join('&') : '' %>"
      class="button-19 owner-button"
    >
      Resolved<%= reportStatusFilter === 'resolved' ? ' (active)' : '' %>
    </a>
    <a
      href="/groups/<%= group.slug %>/moderation?status=dismissed<%= reportFilterParams.length > 0 ? '&' + reportFilterParams.join('&') : '' %>"
      class="button-19 owner-button"
    >
      Dismissed<%= reportStatusFilter === 'dismissed' ? ' (active)' : '' %>
    </a>
  </div>

  <div class="feed-shell">
    <% if (reports.length === 0) { %>
      <article class="feed-card text-start mb-3">
        <p class="mb-0">No reports yet. Everything is clear.</p>
      </article>
    <% } else { %>
      <form action="/groups/<%= group.slug %>/reports/bulk" method="POST" class="mb-3">
        <input type="hidden" name="returnTo" value="<%= moderationReturnPath %>">
        <div class="d-flex flex-column gap-2 mb-3">
          <label class="w-100">
            <span class="text-white-50">Bulk follow-up note</span>
            <textarea name="followUp" rows="2" class="form-control mt-1" placeholder="Optional note for all selected reports"></textarea>
          </label>
          <div class="d-flex flex-wrap gap-2">
            <button type="submit" name="action" value="resolved" class="button-19 owner-button">Resolve selected</button>
            <button type="submit" name="action" value="dismissed" class="button-19 owner-button danger">Dismiss selected</button>
          </div>
        </div>

        <% reports.forEach(report => { %>
          <article class="feed-card text-start mb-3">
            <div class="feed-card-header d-flex align-items-center justify-content-between gap-3">
              <div>
                <strong>Report #<%= report.id %></strong>
                <span><%= report.created_at.toLocaleString() %></span>
              </div>
              <% if (report.status === "open") { %>
                <label class="d-flex align-items-center gap-2 mb-0">
                  <input type="checkbox" name="reportIds" value="<%= report.id %>">
                  <span>Select</span>
                </label>
              <% } %>
            </div>
            <p class="mb-2">
              <strong>Status:</strong> <%= report.status %>
              <% if (report.reviewer_username) { %>
                <span class="text-white-50"> by @<%= report.reviewer_username %></span>
              <% } %>
            </p>
            <p class="mb-2"><strong>Reporter:</strong> @<%= report.reporter_username %></p>
            <p class="mb-2"><strong>Reason:</strong> <%= report.reason %></p>
            <% if (report.details) { %>
              <p class="mb-2"><strong>Details:</strong> <%= report.details %></p>
            <% } %>
            <p class="mb-3"><strong>Reported content:</strong> <%= report.target_content || "(content no longer available)" %></p>

            <% if (report.status === "open") { %>
              <div class="d-flex flex-column gap-2 mt-3">
                <form action="/groups/<%= group.slug %>/reports/<%= report.id %>" method="POST" class="owner-form-inline d-flex flex-column align-items-start gap-2">
                  <input type="hidden" name="action" value="resolved">
                  <input type="hidden" name="returnTo" value="<%= moderationReturnPath %>">
                  <label class="w-100">
                    <span class="text-white-50">Follow-up note</span>
                    <textarea name="followUp" rows="2" class="form-control mt-1" placeholder="Optional note for the moderator record"></textarea>
                  </label>
                  <button type="submit" class="button-19 owner-button">Mark Resolved</button>
                </form>
                <form action="/groups/<%= group.slug %>/reports/<%= report.id %>" method="POST" class="owner-form-inline d-flex flex-column align-items-start gap-2">
                  <input type="hidden" name="action" value="dismissed">
                  <input type="hidden" name="returnTo" value="<%= moderationReturnPath %>">
                  <label class="w-100">
                    <span class="text-white-50">Follow-up note</span>
                    <textarea name="followUp" rows="2" class="form-control mt-1" placeholder="Optional note for the moderator record"></textarea>
                  </label>
                  <button type="submit" class="button-19 owner-button danger">Dismiss</button>
                </form>
              </div>
            <% } %>
          </article>
        <% }) %>
      </form>
    <% } %>
  </div>

  <% if (totalReportPages > 1) { %>
    <div class="d-flex align-items-center justify-content-between mt-3 mb-4">
      <% const pageBase = reportStatusFilter === 'all' ? '' : `status=${reportStatusFilter}&`; %>
      <div>
        <% if (hasPreviousReportPage) { %>
          <a href="/groups/<%= group.slug %>/moderation?<%= pageBase %>page=<%= currentReportPage - 1 %>" class="button-19 owner-button">
            Previous
          </a>
        <% } %>
      </div>
      <p class="mb-0">Page <%= currentReportPage %> of <%= totalReportPages %></p>
      <div>
        <% if (hasNextReportPage) { %>
          <a href="/groups/<%= group.slug %>/moderation?<%= pageBase %>page=<%= currentReportPage + 1 %>" class="button-19 owner-button">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="group-hero text-start mt-5 mb-4">
    <h2 class="h3">Recent moderator actions</h2>
    <p>Every moderation decision is logged for accountability.</p>
  </div>

  <% const reportQueryPrefix = reportStatusFilter === 'all' ? '' : `status=${reportStatusFilter}&`; %>
  <% const actionQueryPrefix = actionTypeFilter === 'all' ? '' : `actionType=${actionTypeFilter}&`; %>
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %>actionType=all" class="button-19 owner-button">
      All<%= actionTypeFilter === 'all' ? ' (active)' : '' %>
    </a>
    <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %>actionType=moderator_added" class="button-19 owner-button">
      Moderator Added<%= actionTypeFilter === 'moderator_added' ? ' (active)' : '' %>
    </a>
    <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %>actionType=report_resolved" class="button-19 owner-button">
      Report Resolved<%= actionTypeFilter === 'report_resolved' ? ' (active)' : '' %>
    </a>
    <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %>actionType=report_dismissed" class="button-19 owner-button">
      Report Dismissed<%= actionTypeFilter === 'report_dismissed' ? ' (active)' : '' %>
    </a>
    <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %>actionType=post_removed" class="button-19 owner-button">
      Post Removed<%= actionTypeFilter === 'post_removed' ? ' (active)' : '' %>
    </a>
  </div>

  <div class="feed-shell">
    <% if (!moderationActions || moderationActions.length === 0) { %>
      <article class="feed-card text-start mb-3">
        <p class="mb-0">No moderation actions yet.</p>
      </article>
    <% } else { %>
      <% moderationActions.forEach(action => { %>
        <% const actionLabelMap = {
          moderator_added: 'Moderator added',
          moderator_removed: 'Moderator removed',
          report_resolved: 'Report resolved',
          report_dismissed: 'Report dismissed',
          post_removed: 'Post removed',
          comment_removed: 'Comment removed'
        }; %>
        <% const actionLabel = actionLabelMap[action.action_type] || action.action_type.replace(/_/g, ' '); %>
        <% const isClosureAction = ['report_resolved', 'report_dismissed'].includes(action.action_type); %>
        <article class="feed-card text-start mb-3">
          <div class="feed-card-header">
            <strong>@<%= action.actor_username %></strong>
            <span><%= action.created_at.toLocaleString() %></span>
          </div>
          <p class="mb-2"><strong>Action:</strong> <%= actionLabel %></p>
          <p class="mb-2"><strong>Target:</strong> <%= action.target_type %><%= action.target_id ? ` #${action.target_id}` : '' %></p>
          <% if (action.reason) { %>
            <p class="mb-2"><strong><%= isClosureAction ? 'Follow-up note' : 'Reason' %>:</strong> <%= action.reason %></p>
          <% } %>
          <% if (action.target_snapshot) { %>
            <p class="mb-0"><strong>Snapshot:</strong> <%= action.target_snapshot %></p>
          <% } %>
        </article>
      <% }) %>
    <% } %>
  </div>

  <% if (totalActionsPages > 1) { %>
    <div class="d-flex align-items-center justify-content-between mt-3 mb-4">
      <div>
        <% if (hasPreviousActionsPage) { %>
          <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %><%= actionQueryPrefix %>actionsPage=<%= currentActionsPage - 1 %>" class="button-19 owner-button">
            Previous
          </a>
        <% } %>
      </div>
      <p class="mb-0">Action page <%= currentActionsPage %> of <%= totalActionsPages %></p>
      <div>
        <% if (hasNextActionsPage) { %>
          <a href="/groups/<%= group.slug %>/moderation?<%= reportQueryPrefix %><%= actionQueryPrefix %>actionsPage=<%= currentActionsPage + 1 %>" class="button-19 owner-button">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</section>

<%- include("partials/footer.ejs") %>
