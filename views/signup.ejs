<%- include("partials/header.ejs") %>

<video autoplay muted loop id="background-video">
  <source src="/public/images/Animated Video Background - Saber Lighting Frame for Edits - Background video effects.mp4" type="video/mp4">
</video>

<main class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
  <div class="post-container">
    <h1>Create Your Account</h1>
    <p class="text-body-secondary">Claim a profile so your posts and future groups belong to you.</p>

    <form action="/signup" method="POST">
      <div class="mb-4 text-start">
        <label class="form-label text-white">Username</label>
        <input class="form-control bg-dark text-white border-secondary" type="text" name="username" maxlength="80" required>
      </div>

      <div class="mb-4 text-start">
        <label class="form-label text-white">Email</label>
        <input class="form-control bg-dark text-white border-secondary" type="email" name="email" required>
      </div>

      <div class="mb-4 text-start">
        <label class="form-label text-white">Password</label>
        <input class="form-control bg-dark text-white border-secondary" type="password" name="password" minlength="6" required>
      </div>

      <div class="d-grid gap-3">
        <button type="submit" class="button-19">Create account</button>
        <a href="/login" class="blog-link">Already have an account?</a>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer.ejs") %>