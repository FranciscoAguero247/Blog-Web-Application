<%- include("partials/header.ejs") %>

<a href="/" class="back-btn">
    <i class="fa-solid fa-chevron-left"></i> Back to Hub
</a>

<video autoplay muted loop id="background-video">
  <source src="/images/tech vid background.mp4" type="video/mp4">
</video>

<div class="center-div-block tech-theme" id="container">
  <% if (locals.posts && posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <div class="internal-blog-post mb-3">
        <p class="card-text"><%= post.content %></p>
        <small class="text-white-50"><%= post.created_at.toLocaleString() %></small>
      </div>
    <% }); %>
  <% } else { %>
    <p>No transmissions in the Nexus yet...</p>
  <% } %>
  
  <div class="post-div-block">
      <form action="/IsubmitT" method="POST">
          <input class="input-form" type="text" name="IndividualBlogPost" placeholder="Type a message..." required />
          <button class="button-19">Post</button>
      </form>
  </div>
</div>

<%- include("partials/footer.ejs") %>