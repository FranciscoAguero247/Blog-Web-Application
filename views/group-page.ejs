<%- include("partials/header.ejs") %>

<video autoplay muted loop id="background-video">
  <source src="/public/images/Animated Video Background - Saber Lighting Frame for Edits - Background video effects.mp4" type="video/mp4">
</video>

<a href="/" class="back-btn">
  <i class="fa-solid fa-chevron-left"></i> Back to Hub
</a>

<section class="container pb-5">
  <% if (!group) { %>
    <div class="feed-card text-start">
      <h1>Community not found</h1>
      <p class="mb-0">The group you tried to open does not exist.</p>
    </div>
  <% } else { %>
    <div class="group-hero text-start mb-4">
      <p class="community-slug">/<%= group.slug %></p>
      <h1><%= group.name %></h1>
      <p><%= group.description || 'A place for people with the same interests to talk and post.' %></p>
      <div class="hero-actions d-flex flex-wrap gap-3">
        <% if (currentUser && !isMember) { %>
          <form action="/groups/<%= group.slug %>/join" method="POST">
            <button type="submit" class="button-19">Join group</button>
          </form>
        <% } %>
        <% if (currentUser) { %>
          <a href="/newpost" class="blog-link">Create a post</a>
        <% } else { %>
          <a href="/login" class="blog-link">Log in to participate</a>
        <% } %>
      </div>
    </div>

    <div class="feed-shell">
      <% if (posts.length > 0) { %>
        <% posts.forEach(post => { %>
          <article class="feed-card text-start mb-3">
            <div class="feed-card-header">
              <strong>@<%= post.username %></strong>
              <span><%= post.created_at.toLocaleString() %></span>
            </div>
            <p class="mb-3"><%= post.content %></p>

            <% if (currentUser && Number(currentUser.id) === Number(post.user_id)) { %>
              <div class="owner-tools mb-3">
                <form action="/posts/<%= post.id %>/edit" method="POST" class="owner-form owner-form-stack">
                  <input type="hidden" name="returnTo" value="/groups/<%= group.slug %>">
                  <textarea name="content" class="form-control bg-dark text-white border-secondary" rows="2" required><%= post.content %></textarea>
                  <button type="submit" class="button-19 owner-button">Save Post</button>
                </form>
                <form action="/posts/<%= post.id %>/delete" method="POST" class="owner-form-inline">
                  <input type="hidden" name="returnTo" value="/groups/<%= group.slug %>">
                  <button type="submit" class="button-19 owner-button danger">Delete Post</button>
                </form>
              </div>
            <% } %>

            <section class="post-comments">
              <p class="comment-count mb-2"><%= post.comments.length %> comments</p>
              <% if (post.comments.length > 0) { %>
                <div class="comment-list mb-3">
                  <% post.comments.forEach(comment => { %>
                    <article class="comment-item">
                      <div class="comment-item-header">
                        <strong>@<%= comment.username %></strong>
                        <small><%= comment.created_at.toLocaleString() %></small>
                      </div>
                      <p class="mb-0"><%= comment.content %></p>
                      <% if (currentUser && Number(currentUser.id) === Number(comment.user_id)) { %>
                        <div class="owner-tools owner-tools-compact mt-3">
                          <form action="/comments/<%= comment.id %>/edit" method="POST" class="owner-form owner-form-stack">
                            <input type="hidden" name="returnTo" value="/groups/<%= group.slug %>">
                            <textarea name="content" class="form-control bg-dark text-white border-secondary" rows="2" required><%= comment.content %></textarea>
                            <button type="submit" class="button-19 owner-button">Save Comment</button>
                          </form>
                          <form action="/comments/<%= comment.id %>/delete" method="POST" class="owner-form-inline">
                            <input type="hidden" name="returnTo" value="/groups/<%= group.slug %>">
                            <button type="submit" class="button-19 owner-button danger">Delete Comment</button>
                          </form>
                        </div>
                      <% } %>
                    </article>
                  <% }) %>
                </div>
              <% } %>

              <% if (currentUser && isMember) { %>
                <form action="/posts/<%= post.id %>/comments" method="POST" class="comment-form">
                  <input type="hidden" name="groupSlug" value="<%= group.slug %>">
                  <textarea
                    name="content"
                    class="form-control bg-dark text-white border-secondary mb-2"
                    rows="2"
                    placeholder="Write a comment"
                    required
                  ></textarea>
                  <button type="submit" class="button-19">Comment</button>
                </form>
              <% } else if (currentUser && !isMember) { %>
                <p class="comment-gate mb-0">Join this community to comment on posts.</p>
              <% } else { %>
                <a href="/login" class="blog-link">Log in to comment</a>
              <% } %>
            </section>
          </article>
        <% }) %>
      <% } else { %>
        <div class="feed-card text-start">
          <p class="mb-0">No posts yet. Start the conversation and define what this group becomes.</p>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<%- include("partials/footer.ejs") %>