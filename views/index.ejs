<%- include("partials/header.ejs") %>
<video autoplay muted loop id="background-video">
        <source src="/public/images/Animated Video Background - Saber Lighting Frame for Edits - Background video effects.mp4" type="video/mp4">
</video>

<section class="container community-hero py-4 py-md-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-6 text-start">
            <p class="eyebrow">Interest-based communities</p>
            <h1>Build discussion spaces around what people actually care about.</h1>
            <p class="lead mb-4">Predefined fandoms are here, but the platform is now ready for members to create their own groups, join communities, and publish posts under a real identity.</p>
            <div class="hero-actions d-flex flex-wrap gap-3">
                <a href="/newpost" class="blog-link">Create a post</a>
                <a href="/groups/new" class="blog-link">Launch a group</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="stats-shell">
                <div class="stat-card">
                    <small>Communities</small>
                    <strong><%= groups.length %></strong>
                </div>
                <div class="stat-card">
                    <small>Recent posts</small>
                    <strong><%= recentPosts.length %></strong>
                </div>
                <div class="stat-card wide">
                    <small>Status</small>
                    <strong><%= currentUser ? 'Signed in and ready to participate' : 'Browse now, sign in to join and post' %></strong>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container pb-5">
    <div class="section-heading text-start mb-4">
        <h2>Communities</h2>
        <p>Default topics stay in place, and every new group created by users appears here too.</p>
    </div>
    <div class="row g-4">
        <% groups.forEach(group => { %>
            <div class="col-md-6 col-xl-3">
                <article class="community-card h-100 text-start">
                    <p class="community-slug">/<%= group.slug %></p>
                    <h3><%= group.name %></h3>
                    <p><%= group.description || 'A place to gather around a shared interest.' %></p>
                    <div class="community-meta">
                        <span><%= group.member_count %> members</span>
                        <span><%= group.post_count %> posts</span>
                    </div>
                    <a href="/groups/<%= group.slug %>" class="blog-link">Open group</a>
                </article>
            </div>
        <% }) %>
    </div>
</section>

<section class="container pb-5">
    <div class="section-heading text-start mb-4">
        <h2>Recent activity</h2>
        <p>The feed starts simple: the newest posts across every community.</p>
    </div>
    <div class="feed-shell">
        <% if (recentPosts.length > 0) { %>
            <% recentPosts.forEach(post => { %>
                <article class="feed-card text-start mb-3">
                    <div class="feed-card-header">
                        <strong>@<%= post.username %></strong>
                        <span>in <%= post.group_name %></span>
                    </div>
                    <p class="mb-2"><%= post.content %></p>
                    <small class="text-white-50"><%= post.created_at.toLocaleString() %></small>
                </article>
            <% }) %>
        <% } else { %>
            <div class="feed-card text-start">
                <p class="mb-0">No activity yet. Create the first post and set the tone for the community.</p>
            </div>
        <% } %>
    </div>
</section>
<%- include("partials/footer.ejs") %>